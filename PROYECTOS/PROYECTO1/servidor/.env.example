# UID del usuario del servidor (salida de: id -u). Airflow escribe logs y target/ de dbt con este usuario.
AIRFLOW_UID=1000

# PostgreSQL de SG-Food (OLTP + DW)
SGFOOD_DB_USER=sgfood
SGFOOD_DB_PASSWORD=cambiar
SGFOOD_DB_PORT=5434

# Airflow
AIRFLOW_DB_PASSWORD=cambiar
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar
AIRFLOW_PORT=8090

# Documentación dbt
DBT_DOCS_PORT=8091
